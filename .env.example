# Copy to .env. Docker Compose and the host-run dev scripts both read it.
# Values below are safe for LOCAL DEV ONLY: on the VPS change every secret.

# --- Postgres (compose creates the DB with these) ---
POSTGRES_USER=omniplay
POSTGRES_PASSWORD=omniplay-dev-password
POSTGRES_DB=omniplay

# Host-run processes (npm run dev:*) connect through PgBouncer on localhost.
# Inside compose these are overridden to the service names (see docker-compose.yml).
DATABASE_URL=postgres://omniplay:omniplay-dev-password@localhost:6432/omniplay
DIRECT_DATABASE_URL=postgres://omniplay:omniplay-dev-password@localhost:5432/omniplay
REDIS_URL=redis://localhost:6379
# Client connections per Node process (PgBouncer multiplexes them onto its server pool).
DB_POOL_MAX=10

# --- API ---
PORT=3000
# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
SECRETS_KEY=dev-only-secrets-key-change-me-0123456789abcdef
IP_HASH_SALT=dev-only-ip-salt-change-me
# Browser origins allowed by CORS (admin gets credentials, public gets *).
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- First owner account (created by the migrate step if no owner exists yet) ---
ADMIN_EMAIL=owner@omniplay.local
ADMIN_PASSWORD=change-me-please

# --- Cloudflare R2 (thumbnails + DB backups). Leave empty to disable uploads/backups. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omniplay
# Public bucket domain (R2 custom domain), e.g. https://media.example.com
R2_PUBLIC_URL=

# --- Production only: Cloudflare Tunnel token (docker compose --profile prod up -d) ---
CLOUDFLARE_TUNNEL_TOKEN=
